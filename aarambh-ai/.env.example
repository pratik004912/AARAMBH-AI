# Copy this file to .env for local development.
# On Render, set these under Environment > Environment Variables instead — never commit a real .env file.

NODE_ENV=development
PORT=3000

# Restrict CORS to your deployed domain once you have one (leave blank locally)
ALLOWED_ORIGIN=

# SMTP settings for the contact form (optional — without these, submissions are just logged)
# Works with any SMTP provider: Gmail (app password), Resend, SendGrid, Zoho, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TO_EMAIL=you@yourdomain.com
